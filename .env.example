# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/student_performance?retryWrites=true&w=majority
MONGO_DB_NAME=student_performance

# Flask Secret Key
SECRET_KEY=your-random-secret-key-here

# Machine Learning Model
MODEL_PATH=student_pass_fail_model.pkl

# Initial Admin Credentials (Generated on first run if not existing)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Flask Debug Mode
FLASK_DEBUG=false
